<%
  const posts = page.posts ? page.posts.data : [];
%>
<section aria-labelledby="page-title">
  <h1 id="page-title">Recent posts</h1>
  <% if (posts.length) { %>
    <%- partial('_partial/post-list', { posts }) %>
    <%- partial('_partial/pagination') %>
  <% } else { %>
    <p class="empty-state">No posts yet. Create one with <code>npx hexo new post "My post title"</code>.</p>
  <% } %>
</section>